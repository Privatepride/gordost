# Токен бота (BotFather)
TELEGRAM_BOT_TOKEN=

# Юзернейм бота без @ — чтобы кнопки мини-приложения открывали нужный раздел в чате (deep link)
TELEGRAM_BOT_USERNAME=

# Порт HTTP-сервера (мини-приложение + API)
PORT=8787

# --- Baserow (как в n8n-воркфлоу «консьерж»): без токена бот работает в локальном демо-режиме ---
# URL без завершающего слэша
BASEROW_API_URL=https://base.gordost.club
BASEROW_API_TOKEN=

# Необязательно: ссылки для экрана согласий в боте
# PRIVACY_POLICY_URL=https://example.com/privacy
# MARKETING_POLICY_URL=https://example.com/marketing

# Необязательно: переопределить ID таблиц/полей, если база другая
# BASEROW_TABLE_RESIDENTS=597
# BASEROW_TABLE_PROJECTS=850
# BASEROW_FIELD_TELEGRAM_ID=5563
# BASEROW_TABLE_EVENTS=838
# BASEROW_TABLE_REGISTRATIONS=839
# BASEROW_FIELD_REG_EVENT=7790
# BASEROW_FIELD_REG_RESIDENT=7791

# Если в Residents есть отдельное поле телефона (имя поля в API, user_field_names)
# BASEROW_FIELD_PHONE=mobile

# Только для отладки: не требовать is_member в Baserow
# BASEROW_RELAX_MEMBER_CHECK=1

# Необязательно: обратная синхронизация профиля через n8n (по умолчанию выключена)
# ENABLE_PROFILE_REVERSE_SYNC=1
# N8N_PROFILE_SYNC_URL=
# N8N_PROFILE_SYNC_SECRET=

# Необязательно: путь к JSON (демо без Baserow)
# DATA_FILE=/var/lib/gordost/data.json

# Необязательно: проверка загружаемых файлов через VirusTotal (как virustotal.com/gui/home/upload)
# Без ключа файлы принимаются без внешней проверки.
# VIRUSTOTAL_API_KEY=
# VIRUSTOTAL_REQUIRED=1
